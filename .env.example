# Host port the API listens on
API_PORT=8000

# Upload limits. Ten megabytes and two hundred pages by default.
MAX_UPLOAD_BYTES=10485760
MAX_PAGES=200

# Comma separated list of origins allowed to call the API.
# "*" is fine for a public demo; set real origins for anything else.
ALLOWED_ORIGINS=*

# OCR for scanned pages. Tesseract language codes joined with "+"; the Docker
# image ships English (eng) and Portuguese (por). OCR takes a second or more
# per page, so scanned pages beyond OCR_MAX_PAGES are skipped and reported.
OCR_ENABLED=true
OCR_LANG=por+eng
OCR_MAX_PAGES=30

# Seconds a conversion may run. Past it, the conversion process and every
# tesseract it started are killed, its temporary files removed, and the
# request answered with a 504 and the code "conversion_timeout". Keep it at
# least a minute under the caller's own timeout: the Automation Core waits
# 300 seconds, hence 240.
CONVERSION_TIMEOUT_SECONDS=240
